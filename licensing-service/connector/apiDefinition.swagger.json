{
  "swagger": "2.0",
  "info": {
    "title": "Licensed Agent Skills",
    "description": "Returns licensed business skills for D365 agents. Sends only the licence key, tenant ID, agent ID and skill name; no business data.",
    "version": "1.0.0"
  },
  "host": "<your-apim-name>.azure-api.net",
  "basePath": "/licensing",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "licenceKey": {
      "type": "apiKey",
      "in": "header",
      "name": "x-licence-key"
    }
  },
  "security": [
    {
      "licenceKey": []
    }
  ],
  "parameters": {
    "agentId": {
      "name": "agentId",
      "in": "path",
      "required": true,
      "type": "string",
      "x-ms-summary": "Agent ID",
      "description": "Agent identifier, e.g. inventory-close-agent or credit-hold-review-agent."
    },
    "tenantId": {
      "name": "x-tenant-id",
      "in": "header",
      "required": false,
      "type": "string",
      "x-ms-summary": "Tenant ID",
      "description": "Microsoft Entra tenant ID of the customer. When sent, it must match the licence."
    }
  },
  "paths": {
    "/v1/agents/{agentId}/licence": {
      "get": {
        "operationId": "GetLicenceStatus",
        "summary": "Get licence status",
        "description": "Checks whether the agent is licensed now. Call at the start of a run; if licensed is false, start no new work and report the notice.",
        "parameters": [
          {
            "$ref": "#/parameters/agentId"
          },
          {
            "$ref": "#/parameters/tenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Licence status",
            "schema": {
              "$ref": "#/definitions/LicenceStatus"
            }
          }
        }
      }
    },
    "/v1/agents/{agentId}/skills": {
      "get": {
        "operationId": "ListSkills",
        "summary": "List skills",
        "description": "Lists the skills this agent may use with name, version and description (routing contract). Use it to choose exactly one skill.",
        "parameters": [
          {
            "$ref": "#/parameters/agentId"
          },
          {
            "$ref": "#/parameters/tenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Skill list",
            "schema": {
              "$ref": "#/definitions/SkillList"
            }
          }
        }
      }
    },
    "/v1/agents/{agentId}/skills/{skillName}": {
      "get": {
        "operationId": "GetSkill",
        "summary": "Get skill",
        "description": "Returns the full instructions of ONE skill by exact name. If licensed is false, stop the task and report the notice.",
        "parameters": [
          {
            "$ref": "#/parameters/agentId"
          },
          {
            "name": "skillName",
            "in": "path",
            "required": true,
            "type": "string",
            "x-ms-summary": "Skill name",
            "description": "Exact skill name, e.g. CHR_CreditPolicy."
          },
          {
            "$ref": "#/parameters/tenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Skill",
            "schema": {
              "$ref": "#/definitions/Skill"
            }
          }
        }
      }
    },
    "/mcp/{agentId}": {
      "post": {
        "operationId": "InvokeLicensedSkillsMCP",
        "summary": "Licensed skills MCP server",
        "description": "MCP server with the tools licence_status, list_skills and get_skill.",
        "x-ms-agentic-protocol": "mcp-streamable-1.0",
        "parameters": [
          {
            "$ref": "#/parameters/agentId"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "definitions": {
    "LicenceStatus": {
      "type": "object",
      "properties": {
        "licensed": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "description": "active, expiring, grace, expired, suspended, not-started, tenant-mismatch, agent-not-licensed"
        },
        "tier": {
          "type": "string"
        },
        "expiresOn": {
          "type": "string"
        },
        "daysLeft": {
          "type": "integer"
        },
        "notice": {
          "type": "string"
        },
        "cacheUntil": {
          "type": "string",
          "description": "Until when (UTC) the caller may use a cached copy if this service becomes unreachable. Never later than the end of the grace period."
        }
      }
    },
    "SkillList": {
      "type": "object",
      "properties": {
        "licensed": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "routing": {
                "type": "string",
                "description": "Exact lowercase task-name phrase this skill handles; empty for supporting skills. Lets a flow route a task without the model."
              },
              "settings": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Environment variable schema names used as {{env:<name>}} placeholders; fill them in the customer's tenant."
              }
            }
          }
        },
        "cacheUntil": {
          "type": "string",
          "description": "Until when (UTC) the caller may use a cached copy if this service becomes unreachable. Never later than the end of the grace period."
        }
      }
    },
    "Skill": {
      "type": "object",
      "properties": {
        "licensed": {
          "type": "boolean"
        },
        "state": {
          "type": "string"
        },
        "notice": {
          "type": "string"
        },
        "skill": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "Skill instructions (Markdown). Empty when not licensed."
        },
        "cacheUntil": {
          "type": "string",
          "description": "Until when (UTC) the caller may use a cached copy if this service becomes unreachable. Never later than the end of the grace period."
        },
        "settings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Environment variable schema names used as {{env:<name>}} placeholders; fill them in the customer's tenant."
        }
      }
    }
  }
}
