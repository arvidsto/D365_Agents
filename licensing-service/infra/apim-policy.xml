<!--
  API-level policy for the "licensing" API in Azure API Management.
  - Forwards to the Function App with its function key (named value "licensing-function-key").
  - Limits calls per licence (the part of x-licence-key before the dot), so one
    customer cannot exhaust the service. Adjust numbers per tier if needed.
  - Strips caller IP and other headers the service does not need.
  - Do NOT enable request/response body logging for this API.
-->
<policies>
  <inbound>
    <base />
    <check-header name="x-licence-key" failed-check-httpcode="401" failed-check-error-message="Licence key missing." ignore-case="true" />
    <set-variable name="licenceId" value="@(context.Request.Headers.GetValueOrDefault(&quot;x-licence-key&quot;,&quot;&quot;).Split('.')[0])" />
    <rate-limit-by-key calls="60" renewal-period="60" counter-key="@((string)context.Variables[&quot;licenceId&quot;])" />
    <quota-by-key calls="100000" renewal-period="2592000" counter-key="@((string)context.Variables[&quot;licenceId&quot;])" />
    <set-header name="x-forwarded-for" exists-action="delete" />
    <set-header name="x-functions-key" exists-action="override">
      <value>{{licensing-function-key}}</value>
    </set-header>
    <set-backend-service base-url="https://{{licensing-function-host}}/api" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
    <set-header name="Cache-Control" exists-action="override"><value>no-store</value></set-header>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
